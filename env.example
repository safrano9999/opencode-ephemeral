# OpenCode itself is installed in Core-pre. These are runtime-only settings.
# OPENCODE_CONFIG may override the default ~/.config/opencode/opencode.json.
OPENCODE_CONFIG=

# Shared MCP groups: the same groups are consumed by Hermes and OpenClaw.
# repeat-group: MCP_SERVER suffix02 MCP_SERVER_NAME MCP_SERVER_URL MCP_SERVER_BEARER MCP_SERVER_ALLOW_PRIVATE
# repeat-optional-complete: MCP_SERVER_NAME MCP_SERVER_BEARER MCP_SERVER_ALLOW_PRIVATE
MCP_SERVER_NAME=
MCP_SERVER_URL=
# secret
MCP_SERVER_BEARER=
# choices: 0 1
# default-preset: 0
MCP_SERVER_ALLOW_PRIVATE=0

# Codex agent ids for this MCP server; ignored by OpenCode, used by OpenClaw.
# repeat-group: MCP_SERVER suffix02 MCP_SERVER_NAME MCP_SERVER_URL MCP_SERVER_BEARER MCP_SERVER_ALLOW_PRIVATE MCP_ALLOW
# repeat-optional-complete: MCP_SERVER_NAME MCP_SERVER_BEARER MCP_SERVER_ALLOW_PRIVATE MCP_ALLOW
# default-preset: *
MCP_ALLOW=*
