# OpenCode itself is installed in Core-pre. These are runtime-only settings.
# OPENCODE_CONFIG may override the default ~/.config/opencode/opencode.json.
OPENCODE_CONFIG=

# Optional HTTP Basic authentication for the OpenCode server and its clients.
# config.sh offers skip/manual/generate; an empty password leaves it unsecured.
#default-preset: opencode
OPENCODE_SERVER_USERNAME=opencode
#secret
OPENCODE_SERVER_PASSWORD=example: openssl rand -hex 32

# Explicit model priority. `chatgpt` uses OpenCode's native OAuth provider.
OPENCODE_DEFAULT_PROVIDER=chatgpt
OPENCODE_DEFAULT_LLM=gpt-6-luna
#repeat-group: OPENCODE_FALLBACK suffix02 OPENCODE_FALLBACK_PROVIDER OPENCODE_FALLBACK_LLM
#repeat-optional-complete: OPENCODE_FALLBACK_PROVIDER OPENCODE_FALLBACK_LLM
OPENCODE_FALLBACK_PROVIDER=litellm
OPENCODE_FALLBACK_LLM=luna
OPENCODE_FALLBACK_PROVIDER_02=litellm-free
OPENCODE_FALLBACK_LLM_02=nvidia/deepseek-ai/deepseek-v4.1-flash

# OpenAI-compatible provider catalogs are discovered from /v1/models at start.
# Optional per-group OPENAI_V1_MODELS(_02, ...) values may add comma-separated
# or JSON model IDs when a catalog is unavailable. Timeout is in seconds.
# OPENAI_V1_DISCOVERY_TIMEOUT=5

# Shared MCP groups: the same groups are consumed by Hermes and OpenClaw.
# repeat-group: MCP_SERVER suffix02 MCP_SERVER_NAME MCP_SERVER_URL MCP_SERVER_BEARER MCP_SERVER_ALLOW_PRIVATE
# repeat-optional-complete: MCP_SERVER_NAME MCP_SERVER_BEARER MCP_SERVER_ALLOW_PRIVATE
MCP_SERVER_NAME=
MCP_SERVER_URL=
# secret
MCP_SERVER_BEARER=
# choices: 0 1
# default-preset: 0
MCP_SERVER_ALLOW_PRIVATE=0

# Codex agent ids for this MCP server; ignored by OpenCode, used by OpenClaw.
# repeat-group: MCP_SERVER suffix02 MCP_SERVER_NAME MCP_SERVER_URL MCP_SERVER_BEARER MCP_SERVER_ALLOW_PRIVATE MCP_ALLOW
# repeat-optional-complete: MCP_SERVER_NAME MCP_SERVER_BEARER MCP_SERVER_ALLOW_PRIVATE MCP_ALLOW
# default-preset: *
MCP_ALLOW=*
